{
    "name": "@tba3/api-resources",
    "version": "0.0.1",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "generate": "export TS_POST_PROCESS_FILE=\"../../node_modules/.bin/prettier --write\" && openapi-generator-cli generate --enable-post-process-file -g typescript-fetch -i https://raw.githubusercontent.com/indibit-eu/tba3/refs/heads/main/tba3-spec.yml --skip-validate-spec -o ./src -c openapi-client-config.json"
    },
    "devDependencies": {
        "@openapitools/openapi-generator-cli": "^2.25.2"
    }
}
